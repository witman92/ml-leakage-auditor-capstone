{
  // Abra ESTE archivo con VS Code (File > Open Workspace from File...)
  // y tendrá el proyecto completo, con los comandos de cada fase en Terminal > Ejecutar tarea.
  // Los scripts usan celdas "# %%": también se pueden ejecutar celda a celda (Run Cell).
  "folders": [{ "path": ".", "name": "Auditor de fuga de datos (Capstone I)" }],
  "settings": {
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["08_tests"],
    "python.analysis.extraPaths": ["01_data", "02_pipelines", "03_auditor", "04_experiments", "06_web_app"],
    "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true },
    "editor.rulers": [100]
  },
  "extensions": { "recommendations": ["ms-python.python", "ms-python.vscode-pylance", "ms-toolsai.jupyter"] },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "▶ Todo el experimento (un comando)", "type": "shell", "command": "python run_all.py", "group": "build" },
      { "label": "▶ Todo, modo rápido (30 s)", "type": "shell", "command": "python run_all.py --rapido" },
      { "label": "Fase 0 · Cargar datasets", "type": "shell", "command": "python 01_data/sklearn_loader.py" },
      { "label": "Fase 1 · Generar 96 pares", "type": "shell", "command": "python 02_pipelines/generate_controlled_pairs.py" },
      { "label": "Fases 2-4 · Benchmark", "type": "shell", "command": "python 04_experiments/run_benchmark.py" },
      { "label": "EDA · Análisis exploratorio", "type": "shell", "command": "python 04_experiments/eda_datasets.py" },
      { "label": "Estadística · Familias", "type": "shell", "command": "python 04_experiments/statistical_analysis.py" },
      { "label": "Sensibilidad · Ruido", "type": "shell", "command": "python 04_experiments/noise_sensitivity.py" },
      { "label": "Demo · Ejemplo visual de fuga", "type": "shell", "command": "python 04_experiments/leakage_demo.py" },
      { "label": "Línea base · Regla simple", "type": "shell", "command": "python 04_experiments/baseline_simple_rule.py" },
      { "label": "Evaluación independiente · 13 casos", "type": "shell", "command": "python 04_experiments/independent_evaluation.py" },
      { "label": "Fase 5 · Sincronizar Skills", "type": "shell", "command": "python 05_skills/sync_skills.py" },
      { "label": "Auditar el archivo abierto", "type": "shell", "command": "python 03_auditor/run_ast_audit.py \"${file}\"" },
      { "label": "Reparar el archivo abierto", "type": "shell", "command": "python 03_auditor/run_ast_audit.py \"${file}\" --fix" },
      { "label": "Plataforma web (Streamlit)", "type": "shell", "command": "streamlit run 06_web_app/app.py", "isBackground": true },
      { "label": "Compilar el informe (LaTeX -> PDF)", "type": "shell", "command": "cd 07_report/latex; latexmk -pdf -interaction=nonstopmode capstone_report_ef.tex" },
      { "label": "Tests", "type": "shell", "command": "python -m pytest 08_tests -q", "group": "test" }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      { "name": "Depurar: auditar el archivo abierto", "type": "debugpy", "request": "launch",
        "program": "${workspaceFolder}/03_auditor/run_ast_audit.py", "args": ["${file}"], "console": "integratedTerminal" },
      { "name": "Depurar: archivo actual", "type": "debugpy", "request": "launch",
        "program": "${file}", "console": "integratedTerminal" }
    ]
  }
}
